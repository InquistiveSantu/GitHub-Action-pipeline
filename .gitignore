# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars and .tfvars.json files containing sensitive data
*.tfvars
*.tfvars.json
**/terraform.tfvars
**/terraform.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI config files
.terraformrc
terraform.rc

# Ignore Terraform plan output files
tfplan
*.tfplan
